# Optional OpenAI-compatible vLLM endpoint; server-side only
VLLM_BASE_URL=
VLLM_MODEL=

# Optional Evolus agent chat API; server-side only.
# EVOLUS_MODEL must be <applicationId>:<agentId> from your Evolus workspace.
# Never prefix server API credentials with NEXT_PUBLIC_ or commit real credentials.
EVOLUS_API_KEY=
EVOLUS_MODEL=

# Optional Evolus website widget. This public widget token is intended for the browser.
# Set it in the Render environment after rotating the exposed token in Evolus.
NEXT_PUBLIC_EVOLUS_WIDGET_TOKEN=

# MongoDB Atlas (server-side only). Set MONGODB_URI for durable incident storage.
# Never prefix secrets with NEXT_PUBLIC_ or commit real credentials.
MONGODB_URI=
MONGODB_DB=factoryguard

# Optional comma-separated DNS resolver IPs if SRV lookup fails on your network
# Example: MONGODB_DNS_SERVERS=8.8.8.8
MONGODB_DNS_SERVERS=
